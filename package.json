{
  "name": "vellum",
  "productName": "Vellum",
  "version": "0.1.0",
  "private": true,
  "description": "Vellum - local desktop design tool",
  "main": "./out/main/index.js",
  "author": "Vellum",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:mcp": "node --experimental-strip-types --no-warnings mcp/test/run-all.mjs",
    "e2e": "node scripts/e2e-all.mjs",
    "electron:download": "node scripts/electron-download.mjs",
    "pack": "npm run electron:download && npm run build && npm run build:mcp && electron-builder --dir",
    "dist": "npm run electron:download && npm run build && npm run build:mcp && electron-builder",
    "build:mcp": "node scripts/build-mcp-bundle.mjs",
    "dist:test": "npm run electron:download && npm run build && npm run build:mcp && electron-builder --win nsis --publish never --config.appId=com.vellum.app.installertest --config.productName=VellumInstallTest --config.directories.output=release-test",
    "dist:update-test": "node scripts/build-update-test.mjs",
    "test:update": "npm run dist:update-test && node scripts/test-update.mjs",
    "test:installer": "npm run dist:test && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer.ps1 -ProductName VellumInstallTest -AppId com.vellum.app.installertest"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "immer": "^11.1.18",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.48.0",
    "nanoid": "^3.3.19",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
