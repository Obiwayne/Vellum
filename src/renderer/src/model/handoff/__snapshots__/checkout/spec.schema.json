    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "textStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textStyle"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
