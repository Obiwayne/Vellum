exports[`snapshots of every file for the fixture > tokens/tailwind.css 1`] = `
"/* tailwind.css — generated by Vellum from the exported frames; do not edit */

/* Tailwind v4: only names in Tailwind's theme namespaces (--color-*, --spacing-*, --radius-*, --font-*, ...) become utilities. */
@theme {
  --color-brand: #2563EB;
  --color-brand-hover: #2563EB;
  --color-surface: #FFFFFF;
  --color-text: oklch(0.2 0.02 250);
  --space-4: 16px;
  --text-xl: 28px;
}

/* Dark mode: plain overrides, outside @theme */
[data-mode="Dark"] {
  --color-brand: #60A5FA;
  --color-brand-hover: #93C5FD;
  --color-surface: #111827;
  --color-text: #F9FAFB;
  --space-4: 16px;
  --text-xl: 28px;
}
"
`;

exports[`snapshots of every file for the fixture > tokens/tokens.css 1`] = `
"/* tokens.css — generated by Vellum from the exported frames; do not edit */
:root {
  --color-brand: #2563EB;
  --color-brand-hover: var(--color-brand);
  --color-surface: #FFFFFF;
  --color-text: oklch(0.2 0.02 250);
  --space-4: 16px;
  --text-xl: 28px;
}

[data-mode="Light"] {
  --color-brand: #2563EB;
  --color-brand-hover: var(--color-brand);
  --color-surface: #FFFFFF;
  --color-text: oklch(0.2 0.02 250);
